{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "rootDir": ".",
        "outDir": "./out-test",
        "types": ["mocha", "node"],
        "skipLibCheck": true
    },
    "include": [
        "tests/**/*.ts",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ]
}
